<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0B1530">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Clube de Física de Sobral | IFCE Campus Sobral</title>
<meta name="description" content="Página do Clube de Física de Sobral (CFS), vinculado ao Curso de Licenciatura em Física do IFCE Campus Sobral.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#F5F7FB;--card:#fff;--tx:#0F1B33;--mut:#55627D;--bd:#DEE4EF;--ac:#2F5BFF;--ac2:#00A88F;--hero:#0B1530;--onhero:#E8EDFB;color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0A1022;--card:#121B33;--tx:#E8EDFB;--mut:#9AA7C4;--bd:#243050;--ac:#7C9BFF;--ac2:#2DD4BF;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0A1022;--card:#121B33;--tx:#E8EDFB;--mut:#9AA7C4;--bd:#243050;--ac:#7C9BFF;--ac2:#2DD4BF;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;text-size-adjust:100%;overflow-x:hidden}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.6 Inter,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-tap-highlight-color:transparent;overflow-x:hidden}
h1,h2,h3{font-family:"Space Grotesk",Inter,system-ui,sans-serif;line-height:1.15;margin:0}
a{color:inherit}button{font:inherit;cursor:pointer}
a,button{touch-action:manipulation}
:focus-visible{outline:2px solid var(--ac2);outline-offset:3px}
.c{max-width:1040px;margin:0 auto;padding:0 20px;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
header{position:sticky;top:0;z-index:10;background:var(--hero);color:var(--onhero);padding-top:env(safe-area-inset-top,0px)}
header .c{display:flex;align-items:center;gap:16px;height:60px}
.brand{font-family:"Space Grotesk",sans-serif;font-weight:700;margin-right:auto;text-decoration:none}.brand span{color:#2DD4BF}
nav{display:flex;gap:4px}nav a{text-decoration:none;color:#B9C4E4;padding:7px 12px;border-radius:8px;font-size:.92rem;transition:.2s}
.tg{background:#18274d;color:#fff;border:0;border-radius:999px;width:38px;height:38px;font-size:1.05rem;flex-shrink:0}
.hero{background:var(--hero);color:var(--onhero);position:relative;overflow:hidden}
.hero .c{display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:center;padding:70px 20px 80px;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
.tag{display:inline-block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:#2DD4BF;font-weight:600;margin-bottom:12px}
.hero h1{font-size:clamp(2.2rem,6vw,3.6rem);letter-spacing:-.03em;margin-bottom:16px}
.hero p{color:#B9C4E4;max-width:560px;margin:0 0 12px}
.orb{width:100%;max-width:320px;margin:auto;display:block}
.orb .r{transform-origin:160px 160px;animation:spin 18s linear infinite}.orb .r2{animation-duration:30s;animation-direction:reverse}
@keyframes spin{to{transform:rotate(360deg)}}
.sec{padding:56px 0}.sec h2{font-size:1.7rem;letter-spacing:-.02em;margin-bottom:6px}.sub{color:var(--mut);margin:0 0 24px}
.quick{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:-34px;position:relative}
.q{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:16px;text-decoration:none;display:flex;flex-direction:column;gap:6px;transition:.2s;box-shadow:0 8px 24px rgba(11,21,48,.12);min-width:0}
.q b{font-size:1.5rem}.q span{font-weight:600}
.goals{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
.goal{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:22px;display:flex;gap:14px;align-items:flex-start}.goal b{font-size:1.5rem}.goal p{margin:0}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:12px;justify-content:space-between;min-width:0}
.card h3{font-size:1.1rem}
.pill{display:inline-block;font-size:.85rem;font-weight:600;padding:6px 12px;border-radius:999px;border:1px solid var(--bd);color:var(--mut);align-self:flex-start}
a.pill{color:var(--ac);border-color:var(--ac);text-decoration:none;transition:.2s}
.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
.row{display:flex;gap:8px;flex-wrap:wrap}
footer{background:var(--hero);color:#B9C4E4;padding:34px 0 calc(34px + env(safe-area-inset-bottom,0px));text-align:center;font-size:.92rem}footer p{margin:2px 0}
@media (hover:hover){
  nav a:hover{color:#fff;background:#18274d}
  .q:hover{transform:translateY(-3px);border-color:var(--ac)}
  a.pill:hover{background:var(--ac);color:var(--bg)}
}
.q:active{border-color:var(--ac)}
a.pill:active{background:var(--ac);color:var(--bg)}nav a:active{color:#fff;background:#18274d}
@media (max-width:760px){
  header .c{height:auto;min-height:52px;flex-wrap:wrap;gap:8px 12px;padding-top:8px;padding-bottom:10px}
  .brand{font-size:1.05rem;letter-spacing:-.02em}
  .tg{width:44px;height:44px}
  nav{order:3;flex:1 0 100%;justify-content:stretch;gap:4px;background:#18274d;border-radius:12px;padding:4px}
  nav a,nav a.keep{flex:1 1 0;display:flex;align-items:center;justify-content:center;text-align:center;white-space:nowrap;color:#E8EDFB;font-size:clamp(.68rem,2.8vw,.82rem);font-weight:600;padding:10px 4px;min-height:44px;border-radius:8px}
  .hero .c{grid-template-columns:1.3fr .7fr;gap:12px 14px;align-items:center;padding:28px 20px 52px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
  .hero h1{font-size:clamp(1.65rem,7.2vw,2.3rem);margin-bottom:10px}
  .hero p{font-size:.92rem;margin:0 0 8px}
  .tag{margin-bottom:8px;font-size:.72rem}
  .orb{max-width:150px;width:100%}
  .c{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
  .quick{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:-28px}
  .q{padding:14px;border-radius:12px;min-height:72px}
  .q b{font-size:1.35rem}
  .q span{font-size:.9rem}
  .sec{padding:40px 0}
  .sec h2{font-size:1.4rem}
  .sub{margin:0 0 16px;font-size:.95rem}
  .goals,.cards,.links{grid-template-columns:1fr;gap:10px}
  .goal,.card{padding:16px;border-radius:14px}
  a.pill,.pill{padding:10px 14px;min-height:40px;display:inline-flex;align-items:center}
  .row{gap:10px}
}
@media (max-width:380px){
  .hero .c{grid-template-columns:1.15fr .85fr;gap:10px}
  .orb{max-width:118px}
  .hero h1{font-size:1.6rem}
}
@media (max-width:760px) and (max-height:500px) and (orientation:landscape){
  .hero .c{grid-template-columns:1.5fr .5fr;padding-top:16px;padding-bottom:40px}
  .orb{max-width:110px}
  header .c{padding-top:4px;padding-bottom:6px}
  nav a,nav a.keep{min-height:40px;padding:8px 4px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
