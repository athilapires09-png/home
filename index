  <a class="q" href="https://ifce.codeberg.page/ClubeFisica/blog/index.html" target="_blank" rel="noopener"><b>📗</b><span>Blog</span></a>
  <a class="q" href="https://pt.wikiversity.org/wiki/Sobral_clube_fisica" target="_blank" rel="noopener"><b>🔗</b><span>Wikiversity</span></a>
  <a class="q" href="https://ifce.codeberg.page/ClubeFisica/blog/2025_10_15_forum.html" target="_blank" rel="noopener"><b>📣</b><span>Grupo</span></a>
  <a class="q" href="https://codeberg.org/IFCE/ClubeFisica/commits/branch/pages" target="_blank" rel="noopener"><b>🔄</b><span>Atualizações</span></a>
